# Copiar a .env (nunca subir .env). Sin secretos reales.
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://farma:farma@db:5432/farmaexpress
POSTGRES_USER=farma
POSTGRES_PASSWORD=farma
POSTGRES_DB=farmaexpress
# Carga datos de demostración al arrancar (idempotente). Úsalo en la demo.
SEED_DEMO=true
