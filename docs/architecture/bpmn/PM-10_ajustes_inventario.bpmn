<startEvent id="s" name="Diferencia con causa y evidencia">
<outgoing>F0</outgoing>
</startEvent>
<userTask id="t1" name="Solicitar ajuste indicando diferencia y motivo">
<incoming>F0</incoming>
<outgoing>F1</outgoing>
</userTask>
<serviceTask id="t2" name="Registrar ajuste PENDIENTE (cantidad anterior y nueva)">
<incoming>F1</incoming>
<outgoing>F2</outgoing>
</serviceTask>
<exclusiveGateway id="g0" name="¿Diferencia ajustable?">
<incoming>F2</incoming>
<outgoing>F3</outgoing>
<outgoing>F4</outgoing>
</exclusiveGateway>
<endEvent id="x0" name="Solicitud rechazada (422)">
<incoming>F4</incoming>
</endEvent>
<userTask id="t3" name="Revisar la evidencia y decidir">
<incoming>F3</incoming>
<outgoing>F5</outgoing>
</userTask>
<exclusiveGateway id="g1" name="¿Evidencia suficiente?">
<incoming>F5</incoming>
<outgoing>F6</outgoing>
<outgoing>F7</outgoing>
</exclusiveGateway>
<userTask id="t4" name="Rechazar el ajuste">
<incoming>F7</incoming>
<outgoing>F8</outgoing>
</userTask>
<endEvent id="x1" name="Ajuste RECHAZADO; existencia sin cambios">
<incoming>F8</incoming>
</endEvent>
<exclusiveGateway id="g2" name="¿Autoriza un responsable distinto del ejecutor?">
<incoming>F6</incoming>
<outgoing>F9</outgoing>
<outgoing>F10</outgoing>
</exclusiveGateway>
<endEvent id="x2" name="Denegado (403): Almacén no autoriza su ajuste">
<incoming>F10</incoming>
</endEvent>
<serviceTask id="t5" name="Registrar autorización: AUTORIZADO, autorizador y fecha">
<incoming>F9</incoming>
<outgoing>F11</outgoing>
</serviceTask>
<intermediateThrowEvent id="e1" name="AjusteDeInventarioAutorizado">
<incoming>F11</incoming>
<outgoing>F12</outgoing>
</intermediateThrowEvent>
<userTask id="t6" name="Aplicar el ajuste autorizado">
<incoming>F12</incoming>
<outgoing>F13</outgoing>
</userTask>
<exclusiveGateway id="g3" name="¿Existencia sin cambios desde la diferencia?">
<incoming>F13</incoming>
<outgoing>F14</outgoing>
<outgoing>F15</outgoing>
</exclusiveGateway>
<endEvent id="x3" name="Aplicación rechazada (422)">
<incoming>F15</incoming>
</endEvent>
<serviceTask id="t7" name="Actualizar existencia, marcar APLICADO y auditar">
<incoming>F14</incoming>
<outgoing>F16</outgoing>
</serviceTask>
<intermediateThrowEvent id="e2" name="AjusteDeInventarioAplicado">
<incoming>F16</incoming>
<outgoing>F17</outgoing>
</intermediateThrowEvent>
<endEvent id="f" name="Existencia ajustada con historial">
<incoming>F17</incoming>
</endEvent>
