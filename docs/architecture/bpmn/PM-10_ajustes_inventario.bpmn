<process id="Proceso_PM-10" name="PM-10 · Autorización y ejecución de ajustes de inventario (US17)" isExecutable="false">
<laneSet id="Lanes_PM-10">
<lane id="Lane_PM-10_0" name="Almacén">
<flowNodeRef>s</flowNodeRef>
<flowNodeRef>t1</flowNodeRef>
<flowNodeRef>t6</flowNodeRef>
</lane>
<lane id="Lane_PM-10_1" name="Responsable de farmacia">
<flowNodeRef>t3</flowNodeRef>
<flowNodeRef>g1</flowNodeRef>
<flowNodeRef>t4</flowNodeRef>
<flowNodeRef>x1</flowNodeRef>
</lane>
