<outgoing>F4</outgoing>
</serviceTask>
<serviceTask id="t3" name="Mostrar cantidades; sin reservas ni transferencias">
<incoming>F4</incoming>
<outgoing>F5</outgoing>
</serviceTask>
<userTask id="t4" name="Decidir con la información registrada">
