<startEvent id="s" name="Producto solicitado requiere sustitución">
<outgoing>F0</outgoing>
</startEvent>
<userTask id="t1" name="Solicitar evaluación de sustitución">
<incoming>F0</incoming>
<outgoing>F1</outgoing>
</userTask>
<userTask id="t2" name="Evaluar alternativas disponibles">
<incoming>F1</incoming>
<outgoing>F2</outgoing>
</userTask>
