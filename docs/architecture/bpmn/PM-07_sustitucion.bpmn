<incoming>F2</incoming>
<outgoing>F3</outgoing>
<outgoing>F4</outgoing>
</exclusiveGateway>
<userTask id="t3" name="Autorizar sustitución con alternativa y motivo">
<incoming>F3</incoming>
<outgoing>F5</outgoing>
</userTask>
<serviceTask id="t4" name="Validar venta EN_PROCESO y alternativa habilitada; reemplazar línea">
<incoming>F5</incoming>
<outgoing>F6</outgoing>
</serviceTask>
<intermediateThrowEvent id="e1" name="SustitucionAutorizada">
<incoming>F6</incoming>
<outgoing>F7</outgoing>
</intermediateThrowEvent>
<userTask id="t5" name="Continuar la venta con la alternativa">
<incoming>F7</incoming>
<outgoing>F8</outgoing>
</userTask>
<userTask id="t6" name="Registrar rechazo con motivo">
<incoming>F4</incoming>
<outgoing>F9</outgoing>
</userTask>
<serviceTask id="t7" name="Guardar decisión; la venta no cambia">
<incoming>F9</incoming>
<outgoing>F10</outgoing>
</serviceTask>
<intermediateThrowEvent id="e2" name="SustitucionRechazada">
<incoming>F10</incoming>
<outgoing>F11</outgoing>
</intermediateThrowEvent>
<userTask id="t8" name="Informar al cliente: continuar sin sustituir o cancelar">
<incoming>F11</incoming>
<outgoing>F12</outgoing>
</userTask>
<endEvent id="f1" name="Venta con sustitución">
<incoming>F8</incoming>
</endEvent>
<endEvent id="f2" name="Sin sustitución">
<incoming>F12</incoming>
</endEvent>
