<startEvent id="s" name="Venta con medicamento que requiere receta">
<outgoing>F0</outgoing>
</startEvent>
<userTask id="t1" name="Revisar receta y capturar folio, médico, cédula, paciente, fecha y resultado">
<incoming>F0</incoming>
<outgoing>F1</outgoing>
</userTask>
<serviceTask id="t2" name="Conservar el registro con el responsable de la revisión">
<incoming>F1</incoming>
<outgoing>F2</outgoing>
</serviceTask>
<intermediateThrowEvent id="e1" name="RecetaRevisada">
<incoming>F2</incoming>
<outgoing>F3</outgoing>
</intermediateThrowEvent>
<userTask id="t3" name="Solicitar consulta del registro">
<incoming>F3</incoming>
<outgoing>F4</outgoing>
</userTask>
<exclusiveGateway id="g1" name="¿Qué rol consulta?">
<incoming>F4</incoming>
<outgoing>F5</outgoing>
<outgoing>F6</outgoing>
<outgoing>F7</outgoing>
</exclusiveGateway>
<serviceTask id="t4" name="Mostrar registro completo y auditar la consulta">
<incoming>F5</incoming>
<outgoing>F8</outgoing>
</serviceTask>
<serviceTask id="t5" name="Mostrar registro sin datos personales de paciente ni médico">
<incoming>F6</incoming>
<outgoing>F9</outgoing>
</serviceTask>
<userTask id="t6" name="Recibir acceso denegado (403)">
<incoming>F7</incoming>
<outgoing>F10</outgoing>
</userTask>
<endEvent id="f1" name="Consulta completa">
<incoming>F8</incoming>
</endEvent>
<endEvent id="f2" name="Consulta restringida">
<incoming>F9</incoming>
</endEvent>
<endEvent id="f3" name="Sin acceso">
<incoming>F10</incoming>
</endEvent>
