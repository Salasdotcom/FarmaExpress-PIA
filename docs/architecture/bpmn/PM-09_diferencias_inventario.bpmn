<sequenceFlow id="F9" name="No" sourceRef="g2" targetRef="t7"/>
<sequenceFlow id="F10" sourceRef="t5" targetRef="t6"/>
<sequenceFlow id="F11" sourceRef="t6" targetRef="f1"/>
<sequenceFlow id="F12" sourceRef="t7" targetRef="t8"/>
<sequenceFlow id="F13" sourceRef="t8" targetRef="f2"/>
</process>
