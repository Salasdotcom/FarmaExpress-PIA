<process id="Proceso_PM-09" name="PM-09 · Investigación de diferencias de inventario (US15, US16)" isExecutable="false">
<laneSet id="Lanes_PM-09">
<lane id="Lane_PM-09_0" name="Almacén">
<flowNodeRef>s</flowNodeRef>
<flowNodeRef>t1</flowNodeRef>
<flowNodeRef>g1</flowNodeRef>
<flowNodeRef>x</flowNodeRef>
<flowNodeRef>t2</flowNodeRef>
</lane>
<lane id="Lane_PM-09_1" name="Responsable de farmacia">
<flowNodeRef>t4</flowNodeRef>
<flowNodeRef>g2</flowNodeRef>
<flowNodeRef>t5</flowNodeRef>
<flowNodeRef>t7</flowNodeRef>
</lane>
<lane id="Lane_PM-09_2" name="Sistema">
<flowNodeRef>t3</flowNodeRef>
<flowNodeRef>e1</flowNodeRef>
<flowNodeRef>t6</flowNodeRef>
<flowNodeRef>f1</flowNodeRef>
<flowNodeRef>t8</flowNodeRef>
<flowNodeRef>f2</flowNodeRef>
</lane>
</laneSet>
<startEvent id="s" name="Conteo físico de un producto">
<outgoing>F0</outgoing>
</startEvent>
<userTask id="t1" name="Comparar existencia física con la registrada">
<incoming>F0</incoming>
<outgoing>F1</outgoing>
</userTask>
<exclusiveGateway id="g1" name="¿Las cantidades coinciden?">
<incoming>F1</incoming>
<outgoing>F2</outgoing>
<outgoing>F3</outgoing>
</exclusiveGateway>
<endEvent id="x" name="Sin diferencia: no se registra">
<incoming>F2</incoming>
</endEvent>
<userTask id="t2" name="Registrar sucursal, producto, lote, ambas cantidades y fecha">
<incoming>F3</incoming>
<outgoing>F4</outgoing>
</userTask>
<serviceTask id="t3" name="Guardar diferencia SIN_INVESTIGAR; la existencia no cambia">
<incoming>F4</incoming>
<outgoing>F5</outgoing>
</serviceTask>
<intermediateThrowEvent id="e1" name="DiferenciaDeInventarioRegistrada">
<incoming>F5</incoming>
<outgoing>F6</outgoing>
</intermediateThrowEvent>
<userTask id="t4" name="Revisar movimientos y evidencia disponible">
<incoming>F6</incoming>
<outgoing>F7</outgoing>
</userTask>
<exclusiveGateway id="g2" name="¿Se identificó la causa?">
<incoming>F7</incoming>
<outgoing>F8</outgoing>
<outgoing>F9</outgoing>
</exclusiveGateway>
<userTask id="t5" name="Documentar causa y evidencia">
<incoming>F8</incoming>
<outgoing>F10</outgoing>
</userTask>
<serviceTask id="t6" name="Estado CAUSA_IDENTIFICADA: diferencia ajustable">
<incoming>F10</incoming>
<outgoing>F11</outgoing>
</serviceTask>
<endEvent id="f1" name="Lista para ajuste (PM-10)">
<incoming>F11</incoming>
</endEvent>
<userTask id="t7" name="Marcar PENDIENTE_ACLARACION">
<incoming>F9</incoming>
<outgoing>F12</outgoing>
</userTask>
<serviceTask id="t8" name="Conservar como pendiente; no ajustable">
<incoming>F12</incoming>
<outgoing>F13</outgoing>
</serviceTask>
<endEvent id="f2" name="Investigación pendiente">
<incoming>F13</incoming>
</endEvent>
