<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PM-12" targetNamespace="https://farmaexpress.example/bpmn">
<process id="Proceso_PM-12" name="PM-12 · Corrección de datos descriptivos de una venta completada (US14)" isExecutable="false">
<laneSet id="Lanes_PM-12">
<lane id="Lane_PM-12_0" name="Usuario autorizado">
<flowNodeRef>s</flowNodeRef>
<flowNodeRef>t1</flowNodeRef>
</lane>
<lane id="Lane_PM-12_1" name="Responsable de farmacia">
<flowNodeRef>t2</flowNodeRef>
<flowNodeRef>g2</flowNodeRef>
<flowNodeRef>x2</flowNodeRef>
</lane>
<lane id="Lane_PM-12_2" name="Sistema">
<flowNodeRef>g1</flowNodeRef>
<flowNodeRef>x1</flowNodeRef>
<flowNodeRef>t3</flowNodeRef>
<flowNodeRef>e1</flowNodeRef>
<flowNodeRef>f</flowNodeRef>
</lane>
</laneSet>
<startEvent id="s" name="Se detecta un error descriptivo en una venta completada">
<outgoing>F0</outgoing>
</startEvent>
<userTask id="t1" name="Solicitar corrección: campo, nuevo valor y motivo">
<incoming>F0</incoming>
<outgoing>F1</outgoing>
</userTask>
<exclusiveGateway id="g1" name="¿Venta COMPLETADA y campo descriptivo?">
<incoming>F1</incoming>
<outgoing>F2</outgoing>
<outgoing>F3</outgoing>
</exclusiveGateway>
<endEvent id="x1" name="Corrección rechazada; venta sin cambios">
<incoming>F3</incoming>
</endEvent>
<userTask id="t2" name="Revisar y decidir la autorización">
<incoming>F2</incoming>
<outgoing>F4</outgoing>
</userTask>
<exclusiveGateway id="g2" name="¿Autoriza la corrección?">
<incoming>F4</incoming>
<outgoing>F5</outgoing>
<outgoing>F6</outgoing>
</exclusiveGateway>
<endEvent id="x2" name="Corrección no aplicada">
<incoming>F6</incoming>
</endEvent>
<serviceTask id="t3" name="Conservar dato original, nuevo, motivo, fecha, ejecutor y autorizador">
<incoming>F5</incoming>
<outgoing>F7</outgoing>
</serviceTask>
<intermediateThrowEvent id="e1" name="VentaCorregida">
<incoming>F7</incoming>
<outgoing>F8</outgoing>
</intermediateThrowEvent>
<endEvent id="f" name="Venta corregida sin alterar su operación económica">
<incoming>F8</incoming>
</endEvent>
<sequenceFlow id="F0" sourceRef="s" targetRef="t1"/>
<sequenceFlow id="F1" sourceRef="t1" targetRef="g1"/>
<sequenceFlow id="F2" name="Sí" sourceRef="g1" targetRef="t2"/>
<sequenceFlow id="F3" name="No" sourceRef="g1" targetRef="x1"/>
<sequenceFlow id="F4" sourceRef="t2" targetRef="g2"/>
<sequenceFlow id="F5" name="Sí" sourceRef="g2" targetRef="t3"/>
<sequenceFlow id="F6" name="No" sourceRef="g2" targetRef="x2"/>
<sequenceFlow id="F7" sourceRef="t3" targetRef="e1"/>
<sequenceFlow id="F8" sourceRef="e1" targetRef="f"/>
</process>
