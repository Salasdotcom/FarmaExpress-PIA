<sequenceFlow id="F5" name="No" sourceRef="g2" targetRef="x2"/>
<sequenceFlow id="F6" sourceRef="t2" targetRef="t3"/>
<sequenceFlow id="F7" sourceRef="t3" targetRef="t4"/>
<sequenceFlow id="F8" sourceRef="t4" targetRef="f"/>
</process>
