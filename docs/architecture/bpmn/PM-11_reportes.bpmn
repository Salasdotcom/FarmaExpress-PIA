<process id="Proceso_PM-11" name="PM-11 · Generación de reportes operativos (US18)" isExecutable="false">
<laneSet id="Lanes_PM-11">
<lane id="Lane_PM-11_0" name="Usuario autorizado">
<flowNodeRef>s</flowNodeRef>
<flowNodeRef>t1</flowNodeRef>
<flowNodeRef>t4</flowNodeRef>
<flowNodeRef>f</flowNodeRef>
</lane>
<lane id="Lane_PM-11_1" name="Sistema">
<flowNodeRef>g1</flowNodeRef>
<flowNodeRef>x1</flowNodeRef>
<flowNodeRef>g2</flowNodeRef>
<flowNodeRef>x2</flowNodeRef>
<flowNodeRef>t2</flowNodeRef>
<flowNodeRef>t3</flowNodeRef>
</lane>
</laneSet>
<startEvent id="s" name="Se requiere supervisar la operación">
<outgoing>F0</outgoing>
</startEvent>
<userTask id="t1" name="Elegir tipo de reporte y filtros (sucursal, producto, lote, estado, periodo)">
<incoming>F0</incoming>
<outgoing>F1</outgoing>
</userTask>
<exclusiveGateway id="g1" name="¿Rol permitido (responsable, Almacén, Compras)?">
<incoming>F1</incoming>
<outgoing>F2</outgoing>
<outgoing>F3</outgoing>
</exclusiveGateway>
<endEvent id="x1" name="Acceso denegado (403)">
<incoming>F3</incoming>
</endEvent>
<exclusiveGateway id="g2" name="¿Tipo de reporte válido?">
<incoming>F2</incoming>
<outgoing>F4</outgoing>
<outgoing>F5</outgoing>
</exclusiveGateway>
<endEvent id="x2" name="Reporte inválido (422)">
<incoming>F5</incoming>
</endEvent>
<serviceTask id="t2" name="Consultar registros y aplicar los filtros que correspondan">
<incoming>F4</incoming>
<outgoing>F6</outgoing>
</serviceTask>
<serviceTask id="t3" name="Presentar el reporte (sin datos personales en ventas especiales)">
<incoming>F6</incoming>
<outgoing>F7</outgoing>
</serviceTask>
<userTask id="t4" name="Analizar la información y decidir">
<incoming>F7</incoming>
<outgoing>F8</outgoing>
</userTask>
<endEvent id="f" name="Supervisión realizada">
<incoming>F8</incoming>
</endEvent>
<sequenceFlow id="F0" sourceRef="s" targetRef="t1"/>
