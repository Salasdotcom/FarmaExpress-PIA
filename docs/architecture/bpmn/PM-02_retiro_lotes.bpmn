<process id="Proceso_PM-02" name="PM-02 · Retiro y seguimiento de lotes (US03, US04)" isExecutable="false">
<laneSet id="Lanes_PM-02">
<lane id="Lane_PM-02_0" name="Responsable de farmacia">
<flowNodeRef>s</flowNodeRef>
<flowNodeRef>t1</flowNodeRef>
<flowNodeRef>t8</flowNodeRef>
</lane>
<lane id="Lane_PM-02_1" name="Almacén">
<flowNodeRef>t3</flowNodeRef>
<flowNodeRef>t4</flowNodeRef>
<flowNodeRef>t7</flowNodeRef>
</lane>
<lane id="Lane_PM-02_2" name="Sistema">
