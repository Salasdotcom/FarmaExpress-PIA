<startEvent id="s" name="Retiro de lote confirmado">
<outgoing>F0</outgoing>
</startEvent>
<userTask id="t1" name="Registrar retiro del lote y su motivo">
<incoming>F0</incoming>
<outgoing>F1</outgoing>
</userTask>
<serviceTask id="t2" name="Marcar lote como retirado y bloquear su venta en todas las sucursales">
<incoming>F1</incoming>
<outgoing>F2</outgoing>
</serviceTask>
<intermediateThrowEvent id="e1" name="LoteRetirado">
<incoming>F2</incoming>
<outgoing>F3</outgoing>
</intermediateThrowEvent>
<userTask id="t3" name="Identificar y separar físicamente las unidades afectadas">
<incoming>F3</incoming>
<outgoing>F4</outgoing>
</userTask>
<userTask id="t4" name="Registrar cantidades identificadas y retiradas por sucursal">
<incoming>F4</incoming>
<incoming>F7</incoming>
<incoming>F10</incoming>
<outgoing>F5</outgoing>
</userTask>
<exclusiveGateway id="g1" name="¿Retiradas ≤ identificadas?">
<incoming>F5</incoming>
<outgoing>F6</outgoing>
<outgoing>F7</outgoing>
</exclusiveGateway>
<serviceTask id="t6" name="Registrar ejecución: retiro EN_EJECUCION y unidades en tránsito pendientes">
<incoming>F6</incoming>
<outgoing>F8</outgoing>
</serviceTask>
<exclusiveGateway id="g2" name="¿Quedan unidades en tránsito pendientes?">
<incoming>F8</incoming>
<outgoing>F9</outgoing>
<outgoing>F11</outgoing>
</exclusiveGateway>
<userTask id="t7" name="Resolver unidades en tránsito (ubicar o confirmar)">
<incoming>F9</incoming>
<outgoing>F10</outgoing>
</userTask>
<userTask id="t8" name="Concluir el retiro">
<incoming>F11</incoming>
<outgoing>F12</outgoing>
</userTask>
<serviceTask id="t9" name="Retiro CONCLUIDO y registro de auditoría (RF-16)">
<incoming>F12</incoming>
<outgoing>F13</outgoing>
</serviceTask>
<endEvent id="f" name="Retiro documentado">
<incoming>F13</incoming>
</endEvent>
